{
  // Apply the same strict options to Svelte components, docs, and demos.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.svelte.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/svelte", "src/core", "src/demos/**/*.svelte", "src/docs/**/*.svelte"],
  "exclude": ["src/core/architecture.test.ts"]
}
