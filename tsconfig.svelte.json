{
  // svelte-check entry: the Svelte layer and everything it reaches. Plain `.ts`
  // and React sources are still typechecked by tsconfig.app.json (`tsc -b`);
  // this project exists so `.svelte` files get the same strict options.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.svelte.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/svelte", "src/core"],
  "exclude": ["src/core/architecture.test.ts"]
}
