{
  "name": "tint",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "Tint — controlled React components for media and rich chat interfaces.",
  "files": [
    "src",
    "!src/docs",
    "!src/test",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "exports": {
    ".": "./src/index.ts",
    "./media-player": "./src/components/media-player/index.ts",
    "./video-player": "./src/components/video-player/index.ts",
    "./media": "./src/components/media/index.ts",
    "./code": "./src/components/code/index.ts",
    "./audio-input": "./src/components/audio-input/index.ts",
    "./settings-popout": "./src/components/settings-popout/index.ts",
    "./chat": "./src/components/chat/index.ts",
    "./table": "./src/components/table/index.ts",
    "./collab": "./src/components/collab/index.ts",
    "./graph": "./src/components/graph/index.ts",
    "./graph/styles.css": "./src/components/graph/graph.css",
    "./theme": "./src/components/theme/index.ts",
    "./icon": "./src/components/icon/index.ts",
    "./dice": "./src/components/dice/index.ts",
    "./panel": "./src/components/panel/index.ts",
    "./badge": "./src/components/badge/index.ts",
    "./progress": "./src/components/progress/index.ts",
    "./dialog": "./src/components/dialog/index.ts",
    "./context-menu": "./src/components/context-menu/index.ts",
    "./tree": "./src/components/tree/index.ts",
    "./toast": "./src/components/toast/index.ts",
    "./socket": "./src/components/socket/index.ts",
    "./editor": "./src/components/editor/index.ts",
    "./terminal": "./src/components/terminal/index.ts",
    "./auth-client": "./src/auth/client/index.ts",
    "./auth": "./src/components/auth/index.ts",
    "./auth/styles.css": "./src/components/auth/styles.css",
    "./styles.css": "./src/index.css",
    "./themes/solarized.css": "./src/styles/themes/solarized.css",
    "./themes/gruvbox.css": "./src/styles/themes/gruvbox.css",
    "./themes/latte.css": "./src/styles/themes/latte.css",
    "./themes/frappe.css": "./src/styles/themes/frappe.css",
    "./themes/macchiato.css": "./src/styles/themes/macchiato.css",
    "./themes/mocha.css": "./src/styles/themes/mocha.css"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/html": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
