{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // themes.test.ts and no-raw-lucide-imports.test.ts read source files off disk,
  // so they are Node-side tests and belong here rather than in the browser project.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/styles/themes.test.ts",
    "src/components/icon/no-raw-lucide-imports.test.ts",
    "src/exports.test.ts",
    "src/docs/propsTable.test.ts"
  ]
}
