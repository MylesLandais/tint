{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Source-inspection tests use Node's filesystem APIs.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/styles/themes.test.ts",
    "src/components/scrolling-label/contract.test.ts",
    "src/exports.test.ts",
    "src/core/architecture.test.ts",
    "src/vendor/checksums.test.ts",
    "src/vendor/boundary.test.ts",
    "src/foundation-adoption.test.ts",
    "src/consumer-contract.test.ts",
    "src/docs/componentGraph.test.ts"
  ]
}
