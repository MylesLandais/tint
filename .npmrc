# Tint publishes to the nebula organization's Forgejo package registry. Only the
# `@nebula` scope is mapped: everything else still resolves from the public npm
# registry, so a typo cannot silently pull a private-looking name from elsewhere.
@nebula:registry=https://git.nebula-1.com/api/packages/nebula/npm/

# The token is never committed. Export NODE_AUTH_TOKEN with a Forgejo access
# token (scope `write:package` to publish, `read:package` to install) — CI reads
# it from the FORGEJO_NPM_TOKEN repository secret.
//git.nebula-1.com/api/packages/nebula/npm/:_authToken=${NODE_AUTH_TOKEN}
